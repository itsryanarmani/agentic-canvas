{
  "name": "agentic-canvas",
  "version": "0.15.4",
  "description": "A shared whiteboard for diagrams, drawn by people and agents.",
  "keywords": [
    "whiteboard",
    "canvas",
    "diagrams",
    "drawing",
    "collaboration",
    "agents",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-canvas.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "llms.txt",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.itsryanarmani/agentic-canvas",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./live-worker": {
      "types": "./dist/live-worker.d.ts",
      "import": "./dist/live-worker.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./file-store": {
      "types": "./dist/store-file.d.ts",
      "import": "./dist/store-file.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/ui.css"
  },
  "bin": {
    "agentic-canvas": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && vite build && node ui/build-css.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "npm run build && WRANGLER_SEND_METRICS=false wrangler dev --port 8793 --var CANVAS_REGION:unknown",
    "dev:smoke": "npm run build && node scripts/dev-smoke.mjs 8793 /health --var CANVAS_REGION:unknown",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:e2e && node scripts/test-packed-account.mjs",
    "deploy:demo": "wrangler deploy -c wrangler.demo.jsonc",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agentic-design": "^0.10.1",
    "agentic-identity": "^0.12.1",
    "agentic-realtime": "^0.6.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "playwright-core": "^1.64.1",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "agentic-design-current": "npm:agentic-design@0.10.1",
    "agentic-identity-current": "npm:agentic-identity@0.12.1",
    "agentic-realtime-current": "npm:agentic-realtime@0.6.1",
    "hono": "^4.13.16",
    "jsdom": "^30.1.3",
    "miniflare": "^4.20260730.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "zod": "$zod"
  }
}